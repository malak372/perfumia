// use prisma-8

// ======================================================
// ENUMS
// ======================================================

enum Role {
  @@type("pg/text@1")

  USER  = "USER"
  ADMIN = "ADMIN"
}

enum MarkerType {
  @@type("pg/text@1")

  ARUCO = "ARUCO"
  QR    = "QR"
}

enum MessageType {
  @@type("pg/text@1")

  NONE  = "NONE"
  TEXT  = "TEXT"
  VOICE = "VOICE"
}

enum OrderSource {
  @@type("pg/text@1")

  WEB    = "WEB"
  MOBILE = "MOBILE"
  KIOSK  = "KIOSK"
}

enum OrderStatus {
  @@type("pg/text@1")

  CREATED         = "CREATED"
  PENDING_PAYMENT = "PENDING_PAYMENT"
  PAID            = "PAID"
  QUEUED          = "QUEUED"
  PROCESSING      = "PROCESSING"
  COMPLETED       = "COMPLETED"
  FAILED          = "FAILED"
  CANCELLED       = "CANCELLED"
}

enum HardwareJobStatus {
  @@type("pg/text@1")

  WAITING   = "WAITING"
  VERIFYING = "VERIFYING"
  PICKING   = "PICKING"
  PLACING   = "PLACING"
  CLOSING   = "CLOSING"
  PRINTING  = "PRINTING"
  WAXING    = "WAXING"
  DONE      = "DONE"
  ERROR     = "ERROR"
  CANCELLED = "CANCELLED"
}

enum InventoryMovementType {
  @@type("pg/text@1")

  RESTOCK    = "RESTOCK"
  RESERVE    = "RESERVE"
  RELEASE    = "RELEASE"
  PICK       = "PICK"
  ADJUSTMENT = "ADJUSTMENT"
}

enum ScentIntensity {
  @@type("pg/text@1")

  LIGHT  = "LIGHT"
  MEDIUM = "MEDIUM"
  STRONG = "STRONG"
}

enum LongevityPreference {
  @@type("pg/text@1")

  SHORT    = "SHORT"
  MODERATE = "MODERATE"
  LONG     = "LONG"
}

enum PaymentProvider {
  @@type("pg/text@1")

  STRIPE = "STRIPE"
}

enum PaymentStatus {
  @@type("pg/text@1")

  PENDING            = "PENDING"
  PROCESSING         = "PROCESSING"
  PAID               = "PAID"
  FAILED             = "FAILED"
  CANCELLED          = "CANCELLED"
  REFUNDED           = "REFUNDED"
  PARTIALLY_REFUNDED = "PARTIALLY_REFUNDED"
}

enum NotificationType {
  @@type("pg/text@1")

  ORDER     = "ORDER"
  PAYMENT   = "PAYMENT"
  SUPPORT   = "SUPPORT"
  SYSTEM    = "SYSTEM"
  PROMOTION = "PROMOTION"
}

enum SupportTicketCategory {
  @@type("pg/text@1")

  PAYMENT  = "PAYMENT"
  ORDER    = "ORDER"
  ACCOUNT  = "ACCOUNT"
  HARDWARE = "HARDWARE"
  DELIVERY = "DELIVERY"
  OTHER    = "OTHER"
}

enum SupportTicketStatus {
  @@type("pg/text@1")

  OPEN        = "OPEN"
  IN_PROGRESS = "IN_PROGRESS"
  RESOLVED    = "RESOLVED"
  CLOSED      = "CLOSED"
}

enum TicketAttachmentType {
  @@type("pg/text@1")

  IMAGE = "IMAGE"
  AUDIO = "AUDIO"
  FILE  = "FILE"
}

enum ContactMessageStatus {
  @@type("pg/text@1")

  NEW     = "NEW"
  READ    = "READ"
  REPLIED = "REPLIED"
  CLOSED  = "CLOSED"
}

enum AiProvider {
  @@type("pg/text@1")

  OPENAI    = "OPENAI"
  GOOGLE    = "GOOGLE"
  ANTHROPIC = "ANTHROPIC"
  OTHER     = "OTHER"
}

enum AiModelPurpose {
  @@type("pg/text@1")

  PERFUME_RECOMMENDATION = "PERFUME_RECOMMENDATION"
  TEXT_GENERATION        = "TEXT_GENERATION"
  OTHER                  = "OTHER"
}


// ======================================================
// USER
// ======================================================

model User {
  id    Uuid   @id @default(uuid())
  email String @unique
  name  String?

  role Role @default(USER)

  // Soft delete
  deletedAt DateTime?

  preferences     GiftPreference[]
  orders          Order[]
  payments        Payment[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  contactMessages ContactMessage[]

  settings UserSettings?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// USER SETTINGS
// ======================================================

model UserSettings {
  id Uuid @id @default(uuid())

  userId Uuid @unique

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  emailNotifications     Boolean @default(true)
  pushNotifications      Boolean @default(true)
  orderUpdates           Boolean @default(true)
  paymentUpdates         Boolean @default(true)
  supportUpdates         Boolean @default(true)
  marketingNotifications Boolean @default(false)

  language String @default("en")

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// PERFUME CATALOG
// ======================================================

model Perfume {
  id  Uuid   @id @default(uuid())
  sku String @unique

  name  String
  brand String

  price Numeric(10, 2)

  fragranceFamily String

  // Example:
  // ["vanilla", "rose", "jasmine"]
  notes String[]

  // Example:
  // ["sweet", "floral", "elegant", "evening"]
  tags String[]

  intensity ScentIntensity?

  longevity LongevityPreference?

  // Full perfume description editable by Admin.
  description String?

  // File path inside public Supabase bucket:
  // perfume-images
  //
  // Example:
  // PERF-001/main.webp
  imageStoragePath String?

  // Admin can hide perfume without deleting it.
  active Boolean @default(true)

  bins                Bin[]
  recommendationItems RecommendationItem[]
  orders              Order[]
  inventoryMovements  InventoryMovement[]

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// STORAGE BINS
// ======================================================

model Bin {
  id   Uuid   @id @default(uuid())
  code String @unique

  // Example:
  // B1 = row 1, column 1
  row    Int
  column Int

  // QR or ArUco assigned by Admin.
  markerType MarkerType @default(ARUCO)

  // Examples:
  // "1"
  // "B1"
  // "ARUCO-01"
  markerValue String @unique

  // File path inside public Supabase bucket:
  // bin-markers
  //
  // Example:
  // B1/marker.png
  markerImagePath String?

  capacity Int?

  // Physical available quantity.
  quantity Int @default(0)

  // Quantity temporarily reserved for orders.
  reservedQuantity Int @default(0)

  // Admin chooses which perfume belongs to this bin.
  perfumeId Uuid?

  perfume Perfume? @relation(
    fields: [perfumeId],
    references: [id],
    onDelete: SetNull
  )

  hardwareJobs       HardwareJob[]
  inventoryMovements InventoryMovement[]

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@unique([row, column])

  @@rls
}


// ======================================================
// GIFT PREFERENCES
// ======================================================

model GiftPreference {
  id Uuid @id @default(uuid())

  // NULL for guest orders.
  userId Uuid?

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  // Recipient does NOT need a PERFUMIA account.
  // This is the name printed on the gift.
  recipientName String

  // Optional AI recommendation signal.
  age Int?

  budget Numeric(10, 2)

  // User free-text description.
  // Example:
  // "I want something elegant, floral and slightly sweet."
  description String?

  // Example:
  // ["rose", "vanilla", "jasmine"]
  preferredNotes String[]

  // Example:
  // ["floral", "sweet", "fresh"]
  fragrancePreferences String[]

  intensity ScentIntensity?

  longevity LongevityPreference?

  // Examples:
  // elegant
  // romantic
  // fresh
  // luxurious
  fragranceStyle String?

  recommendationRuns RecommendationRun[]

  order Order?

  createdAt temporal.createdAt()

  @@rls
}


// ======================================================
// AI RECOMMENDATION RUN
// ======================================================

model RecommendationRun {
  id Uuid @id @default(uuid())

  preferenceId Uuid

  preference GiftPreference @relation(
    fields: [preferenceId],
    references: [id],
    onDelete: Cascade
  )

  aiModelId Uuid?

  aiModel AiModel? @relation(
    fields: [aiModelId],
    references: [id],
    onDelete: SetNull
  )

  // Snapshot of engine/model used.
  engine        String?
  engineVersion String?

  // Exact recommendation input at that moment.
  inputSnapshot Jsonb?

  items RecommendationItem[]

  createdAt temporal.createdAt()

  @@rls
}


// ======================================================
// RECOMMENDATION RESULT
// ======================================================

model RecommendationItem {
  id Uuid @id @default(uuid())

  runId Uuid

  run RecommendationRun @relation(
    fields: [runId],
    references: [id],
    onDelete: Cascade
  )

  perfumeId Uuid

  perfume Perfume @relation(
    fields: [perfumeId],
    references: [id]
  )

  // 1 / 2 / 3
  rank Int

  score Float?

  // AI explanation displayed to customer.
  reason String?

  createdAt temporal.createdAt()

  @@unique([runId, rank])
  @@unique([runId, perfumeId])

  @@rls
}


// ======================================================
// ORDER
// ======================================================

model Order {
  id Uuid @id @default(uuid())

  orderNumber String @unique

  // NULL = Guest order.
  // Filled = Registered user order.
  userId Uuid?

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  // WEB / MOBILE / KIOSK
  source OrderSource

  // Guest contact / receipt information.
  contactEmail String?
  contactPhone String?

  // Secure token used for guest tracking.
  //
  // Example:
  // /track/{trackingToken}
  trackingToken Uuid @unique @default(uuid())

  preferenceId Uuid @unique

  preference GiftPreference @relation(
    fields: [preferenceId],
    references: [id]
  )

  selectedPerfumeId Uuid

  selectedPerfume Perfume @relation(
    fields: [selectedPerfumeId],
    references: [id]
  )

  // Snapshot of perfume price when order was made.
  unitPrice Numeric(10, 2)

  status OrderStatus @default(CREATED)

  giftMessage GiftMessage?

  hardwareJob HardwareJob?

  payments Payment[]

  notifications Notification[]

  supportTickets SupportTicket[]

  inventoryMovements InventoryMovement[]

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// GIFT MESSAGE + QR
// ======================================================

model GiftMessage {
  id Uuid @id @default(uuid())

  orderId Uuid @unique

  order Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  // NONE / TEXT / VOICE
  type MessageType @default(NONE)

  // Text message for recipient.
  messageText String?

  // File path inside PRIVATE Supabase bucket:
  // gift-voice-messages
  //
  // Example:
  // ORDER-1001/message.webm
  //
  // Backend generates a temporary Signed URL when needed.
  audioStoragePath String?

  // Public random token embedded in gift QR.
  // Never expose Order ID directly.
  qrToken Uuid @unique @default(uuid())

  qrUrl String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// PAYMENT
// ======================================================

model Payment {
  id Uuid @id @default(uuid())

  // NULL when Guest pays.
  userId Uuid?

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  orderId Uuid

  order Order @relation(
    fields: [orderId],
    references: [id]
  )

  provider PaymentProvider @default(STRIPE)

  amount Numeric(10, 2)

  currency String @default("USD")

  status PaymentStatus @default(PENDING)

  stripePaymentIntentId String? @unique

  stripeCheckoutSessionId String? @unique

  failureCode String?

  failureMessage String?

  paidAt DateTime?

  refundedAt DateTime?

  events PaymentEvent[]

  supportTickets SupportTicket[]

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// PAYMENT EVENTS / STRIPE WEBHOOKS
// ======================================================

model PaymentEvent {
  id Uuid @id @default(uuid())

  paymentId Uuid

  payment Payment @relation(
    fields: [paymentId],
    references: [id],
    onDelete: Cascade
  )

  // Stripe webhook Event ID.
  providerEventId String @unique

  eventType String

  // Original provider event details.
  payload Jsonb?

  processed Boolean @default(false)

  processedAt DateTime?

  createdAt temporal.createdAt()

  @@rls
}


// ======================================================
// INVENTORY MOVEMENT
// ======================================================

model InventoryMovement {
  id Uuid @id @default(uuid())

  binId Uuid

  bin Bin @relation(
    fields: [binId],
    references: [id]
  )

  perfumeId Uuid

  perfume Perfume @relation(
    fields: [perfumeId],
    references: [id]
  )

  orderId Uuid?

  order Order? @relation(
    fields: [orderId],
    references: [id],
    onDelete: SetNull
  )

  // RESTOCK / RESERVE / RELEASE / PICK / ADJUSTMENT
  type InventoryMovementType

  // Examples:
  // RESTOCK = +5
  // PICK    = -1
  stockDelta Int @default(0)

  // Examples:
  // RESERVE = +1
  // PICK    = -1
  reservedDelta Int @default(0)

  note String?

  createdAt temporal.createdAt()

  @@rls
}


// ======================================================
// HARDWARE JOB
// ======================================================

model HardwareJob {
  id Uuid @id @default(uuid())

  orderId Uuid @unique

  order Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  // Bin selected for physical pick.
  targetBinId Uuid

  targetBin Bin @relation(
    fields: [targetBinId],
    references: [id]
  )

  status HardwareJobStatus @default(WAITING)

  retryCount Int @default(0)

  errorCode String?

  errorMessage String?

  startedAt DateTime?

  completedAt DateTime?

  events HardwareJobEvent[]

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// HARDWARE JOB EVENTS
// ======================================================

model HardwareJobEvent {
  id Uuid @id @default(uuid())

  jobId Uuid

  job HardwareJob @relation(
    fields: [jobId],
    references: [id],
    onDelete: Cascade
  )

  status HardwareJobStatus

  message String?

  // Examples:
  // detected ArUco / QR
  // expected marker
  // camera coordinates
  // gripper position
  // ESP32 response
  // verification result
  // sensor state
  details Jsonb?

  createdAt temporal.createdAt()

  @@rls
}


// ======================================================
// NOTIFICATIONS
// ======================================================

model Notification {
  id Uuid @id @default(uuid())

  // Notifications are for registered users.
  // Guests/Kiosk use realtime order tracking.
  userId Uuid

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  orderId Uuid?

  order Order? @relation(
    fields: [orderId],
    references: [id],
    onDelete: SetNull
  )

  type NotificationType

  title String

  message String

  read Boolean @default(false)

  readAt DateTime?

  createdAt temporal.createdAt()

  @@rls
}


// ======================================================
// SUPPORT / COMPLAINT TICKETS
// ======================================================

model SupportTicket {
  id Uuid @id @default(uuid())

  ticketNumber String @unique

  // NULL when ticket belongs to Guest.
  userId Uuid?

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  // Guest information.
  // Can also be kept as snapshots for registered users.
  requesterName String?

  requesterEmail String?

  // Optional order relation.
  orderId Uuid?

  order Order? @relation(
    fields: [orderId],
    references: [id],
    onDelete: SetNull
  )

  // Optional payment relation.
  paymentId Uuid?

  payment Payment? @relation(
    fields: [paymentId],
    references: [id],
    onDelete: SetNull
  )

  category SupportTicketCategory

  subject String

  message String

  status SupportTicketStatus @default(OPEN)

  adminReply String?

  // Image / voice / file attachments.
  attachments SupportTicketAttachment[]

  resolvedAt DateTime?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// SUPPORT TICKET ATTACHMENTS
// ======================================================

model SupportTicketAttachment {
  id Uuid @id @default(uuid())

  ticketId Uuid

  ticket SupportTicket @relation(
    fields: [ticketId],
    references: [id],
    onDelete: Cascade
  )

  // IMAGE / AUDIO / FILE
  type TicketAttachmentType

  fileName String?

  // Examples:
  // image/jpeg
  // image/png
  // image/webp
  // audio/webm
  // audio/mpeg
  // audio/mp4
  // audio/wav
  // application/pdf
  mimeType String?

  // File path inside PRIVATE Supabase bucket:
  // support-attachments
  //
  // Example:
  // TICKET-1001/image-1.jpg
  storagePath String

  sizeBytes Int?

  createdAt temporal.createdAt()

  @@rls
}


// ======================================================
// CONTACT BOX
// ======================================================

model ContactMessage {
  id Uuid @id @default(uuid())

  // NULL because visitor may contact PERFUMIA
  // without an account.
  userId Uuid?

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  name String

  email String

  subject String

  message String

  status ContactMessageStatus @default(NEW)

  adminReply String?

  repliedAt DateTime?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}


// ======================================================
// AI MODELS
// ======================================================

model AiModel {
  id Uuid @id @default(uuid())

  // Friendly Admin name.
  // Example:
  // "Main Perfume Recommender"
  name String

  provider AiProvider

  // Actual provider model ID.
  modelIdentifier String

  purpose AiModelPurpose @default(PERFUME_RECOMMENDATION)

  enabled Boolean @default(true)

  priority Int @default(1)

  // Non-secret configuration only.
  //
  // Example:
  // {
  //   "temperature": 0.3,
  //   "maxTokens": 800
  // }
  //
  // API keys MUST NOT be stored here.
  configuration Jsonb?

  recommendationRuns RecommendationRun[]

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@unique([provider, modelIdentifier, purpose])

  @@rls
}


// ======================================================
// SYSTEM SETTINGS
// ======================================================

model SystemSetting {
  id Uuid @id @default(uuid())

  // Examples:
  // kiosk.welcomeMessage
  // recommendation.maxResults
  // hardware.enabled
  key String @unique

  value Jsonb

  description String?

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@rls
}
